# ============================================================
# Portfolio Backend — Environment Variables Example
# Copy to .env (for local dev) or server/.env (for server-only)
# NEVER commit the actual .env file with real secrets.
# ============================================================

# ── Server Configuration ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Client Frontend URL (CORS allowed origin) ─────────────────
# Development:  http://localhost:5173
# Production:   https://portfolio-1-cyan-mu.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ── GitHub Integration (BACKEND ONLY — NEVER expose to frontend) ──
# Required for GET /api/projects to fetch live GitHub repositories.
# Scope required: public_repo (read-only is sufficient)
# Create at: https://github.com/settings/tokens
GITHUB_USERNAME=Archish2007Gupta
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Admin Authentication ───────────────────────────────────────
# ADMIN_PASSWORD_HASH must be a bcrypt hash (cost factor 12 recommended).
# Generate with:   node -e "const b=require('bcrypt'); b.hash('yourpassword',12).then(h=>console.log(h))"
# Or:              npx bcrypt-cli hash yourpassword 12
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# ── Session & Security Secret ─────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your_super_secret_session_key_min_32_characters_here

# ── Frontend API Base URL (VITE / Frontend only) ──────────────
# Used by the React frontend to locate the backend API.
# Development:  Leave empty or unset — Vite proxy handles /api → localhost:5000
# Production:   Set to your Railway backend URL (no trailing slash)
#               Example: https://portfolio-backend-production.up.railway.app
# Set this in the VERCEL Dashboard under Project → Settings → Environment Variables
# NEVER put GITHUB_TOKEN, SESSION_SECRET, ADMIN_PASSWORD_HASH in VITE_* variables
VITE_API_BASE_URL=
