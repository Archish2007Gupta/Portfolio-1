# Dependencies
node_modules/
.pnpm-store/

# Production build outputs
dist/
dist-ssr/
build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Note: railway.json is intentionally tracked — it contains NO secrets.
# Secrets (GITHUB_TOKEN, SESSION_SECRET, ADMIN_PASSWORD_HASH) are set
# in the Railway Dashboard → Service → Variables, never in code.

